<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Padding="6,0,8,0"
    ColumnSpacing="4"
    RowSpacing="0"
    MinHeight="24">
    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AddedDiffLineBackgroundBrush" Color="#140B6A0B" />
                    <SolidColorBrush x:Key="DeletedDiffLineBackgroundBrush" Color="#14C42B1C" />
                    <SolidColorBrush x:Key="HunkDiffLineBackgroundBrush" Color="#14127E6F" />
                    <SolidColorBrush x:Key="AddedDiffLineStrokeBrush" Color="#FF0B6A0B" />
                    <SolidColorBrush x:Key="DeletedDiffLineStrokeBrush" Color="#FFC42B1C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AddedDiffLineBackgroundBrush" Color="#220B6A0B" />
                    <SolidColorBrush x:Key="DeletedDiffLineBackgroundBrush" Color="#22C42B1C" />
                    <SolidColorBrush x:Key="HunkDiffLineBackgroundBrush" Color="#1490DBB8" />
                    <SolidColorBrush x:Key="AddedDiffLineStrokeBrush" Color="#FF6CCB5F" />
                    <SolidColorBrush x:Key="DeletedDiffLineStrokeBrush" Color="#FFFF5757" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="AddedDiffLineBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="DeletedDiffLineBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="HunkDiffLineBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                    <StaticResource x:Key="AddedDiffLineStrokeBrush" ResourceKey="SystemColorHotlightColorBrush" />
                    <StaticResource x:Key="DeletedDiffLineStrokeBrush" ResourceKey="SystemColorHighlightColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style
                x:Key="CodeTextBlockStyle"
                TargetType="TextBlock"
                BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>
        </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition x:Name="OldLineNumberColumn" Width="36" />
        <ColumnDefinition x:Name="NewLineNumberColumn" Width="36" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="AddedBackground" Grid.ColumnSpan="5" Margin="-6,0,-8,0" Background="{ThemeResource AddedDiffLineBackgroundBrush}" Visibility="Collapsed" />
    <Border x:Name="DeletedBackground" Grid.ColumnSpan="5" Margin="-6,0,-8,0" Background="{ThemeResource DeletedDiffLineBackgroundBrush}" Visibility="Collapsed" />
    <Border x:Name="HunkBackground" Grid.ColumnSpan="5" Margin="-6,2,-8,2" Background="{ThemeResource HunkDiffLineBackgroundBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Visibility="Collapsed" />
    <Border x:Name="AddedStroke" Grid.ColumnSpan="5" Margin="-6,0,-8,0" BorderBrush="{ThemeResource AddedDiffLineStrokeBrush}" BorderThickness="3,0,0,0" Visibility="Collapsed" />
    <Border x:Name="DeletedStroke" Grid.ColumnSpan="5" Margin="-6,0,-8,0" BorderBrush="{ThemeResource DeletedDiffLineStrokeBrush}" BorderThickness="3,0,0,0" Visibility="Collapsed" />
    <Border x:Name="SelectedStroke" Grid.ColumnSpan="5" Margin="-6,0,-8,0" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3,0,0,0" Visibility="Collapsed" />
    <Button
        x:Name="FoldButton"
        Width="24"
        Height="24"
        MinWidth="24"
        MinHeight="24"
        MaxWidth="24"
        MaxHeight="24"
        Padding="0"
        VerticalAlignment="Center"
        Style="{StaticResource SubtleButtonStyle}"
        Visibility="Collapsed">
        <FontIcon x:Name="FoldGlyph" FontSize="12" />
    </Button>
    <Button
        x:Name="CommentGutterButton"
        Width="24"
        Height="24"
        MinWidth="24"
        MinHeight="24"
        MaxWidth="24"
        MaxHeight="24"
        Padding="0"
        VerticalAlignment="Center"
        Style="{StaticResource SubtleButtonStyle}"
        Visibility="Collapsed">
        <FontIcon FontSize="12" Glyph="&#xE8BD;" />
    </Button>
    <TextBlock
        x:Name="OldLineNumber"
        Grid.Column="1"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
        Style="{StaticResource CaptionTextBlockStyle}"
        TextAlignment="Right"
        Typography.NumeralAlignment="Tabular" />
    <TextBlock
        x:Name="NewLineNumber"
        Grid.Column="2"
        VerticalAlignment="Center"
        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
        Style="{StaticResource CaptionTextBlockStyle}"
        TextAlignment="Right"
        Typography.NumeralAlignment="Tabular" />
    <TextBlock
        x:Name="AddedMarker"
        Grid.Column="3"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{ThemeResource AddedDiffLineStrokeBrush}"
        Style="{StaticResource CaptionTextBlockStyle}"
        Visibility="Collapsed" />
    <TextBlock
        x:Name="DeletedMarker"
        Grid.Column="3"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{ThemeResource DeletedDiffLineStrokeBrush}"
        Style="{StaticResource CaptionTextBlockStyle}"
        Visibility="Collapsed" />
    <TextBlock
        x:Name="CodeText"
        Grid.Column="4"
        VerticalAlignment="Center"
        IsTextSelectionEnabled="True"
        MinWidth="0"
        Padding="0,2"
        Style="{StaticResource CodeTextBlockStyle}"
        TextWrapping="NoWrap" />
    <Button
        x:Name="FocusedCodeButton"
        Grid.Column="4"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        Padding="0,2"
        Style="{StaticResource SubtleButtonStyle}"
        Visibility="Collapsed">
        <TextBlock x:Name="FocusedCodeText" Style="{StaticResource CodeTextBlockStyle}" TextWrapping="NoWrap" />
    </Button>
    <StackPanel x:Name="FoldSummaryPanel" Grid.Row="1" Grid.Column="4" Margin="0,2,0,4" Spacing="4" Visibility="Collapsed">
        <TextBlock x:Name="FoldSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
    <StackPanel
        x:Name="InlineComments"
        Grid.Row="2"
        Grid.Column="4"
        Margin="0,4,0,8"
        MaxWidth="720"
        HorizontalAlignment="Stretch"
        Spacing="8"
        Visibility="Collapsed" />
</Grid>
