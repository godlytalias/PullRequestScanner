<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    MinHeight="24">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid x:Name="LeftHost">
        <Grid x:Name="LeftEmpty" Background="{ThemeResource LayerFillColorAltBrush}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                Text="&#x2215;"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
    <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Grid x:Name="RightHost" Grid.Column="2">
        <Grid x:Name="RightEmpty" Background="{ThemeResource LayerFillColorAltBrush}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                Text="&#x2215;"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Grid>
