<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PullRequestScanner.App.ReviewActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PullRequestScanner.App.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="ActivityDayTemplate" x:DataType="vm:ReviewActivityDayViewModel">
            <Grid
                MinWidth="24"
                HorizontalAlignment="Stretch"
                IsTabStop="True"
                AutomationProperties.Name="{x:Bind Tooltip}"
                ToolTipService.ToolTip="{x:Bind Tooltip}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="152" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid
                        HorizontalAlignment="Center"
                        ColumnSpacing="4"
                        VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="8"
                            Height="{x:Bind PullRequestBarHeight}"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4,4,0,0" />
                        <Border
                            Grid.Column="1"
                            Width="8"
                            Height="{x:Bind CommentBarHeight}"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                            CornerRadius="4,4,0,0" />
                        <Border
                            Grid.Column="2"
                            Width="8"
                            Height="{x:Bind ReviewBarHeight}"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource SystemFillColorCautionBrush}"
                            CornerRadius="4,4,0,0" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DayLabel}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RecentReviewTemplate" x:DataType="vm:RecentReviewActivityViewModel">
            <Grid
                Padding="12"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Location}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <Border
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Status}" />
                    </Border>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ActivityDate}"
                        TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="ActivityBackButton"
                Click="ActivityBackButton_Click">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    x:Uid="ActivityDashboardTitle"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.MonthLabel, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Uid="PreviousActivityMonthButton"
                    Command="{x:Bind ViewModel.PreviousMonthCommand, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" />
                </Button>
                <Button
                    x:Uid="NextActivityMonthButton"
                    Command="{x:Bind ViewModel.NextMonthCommand, Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" />
                </Button>
                <ProgressRing
                    Width="20"
                    Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="256" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                    Padding="16"
                    RowSpacing="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="PullRequestActivityTotalLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.PullRequestTotal, Mode=OneWay}" />
                </Grid>
                <Grid
                    Grid.Column="1"
                    Padding="16"
                    RowSpacing="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="CommentActivityTotalLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.CommentTotal, Mode=OneWay}" />
                </Grid>
                <Grid
                    Grid.Column="2"
                    Padding="16"
                    RowSpacing="4"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="ReviewActivityTotalLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.ReviewTotal, Mode=OneWay}" />
                </Grid>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="16"
                RowSpacing="12"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}" />
                        <TextBlock x:Uid="PullRequestChartLegend" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{ThemeResource SystemFillColorSuccessBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}" />
                        <TextBlock x:Uid="CommentChartLegend" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{ThemeResource SystemFillColorCautionBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}" />
                        <TextBlock x:Uid="ReviewChartLegend" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="152" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ChartMaximum, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ChartMidpointLabel, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="0" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="152" />
                            <RowDefinition Height="24" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,1" />
                            <Border
                            Grid.Row="1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" />
                        </Grid>
                        <ItemsRepeater
                            Grid.RowSpan="2"
                            ItemTemplate="{StaticResource ActivityDayTemplate}"
                            ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="SpaceBetween"
                                    ItemsStretch="Fill"
                                    MaximumRowsOrColumns="31"
                                    MinColumnSpacing="1"
                                    MinItemWidth="20"
                                    MinRowSpacing="0"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Grid>
                </Grid>
            </Grid>
            <Grid
                Grid.Row="2"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Uid="RecentReviewsHeader"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    ItemTemplate="{StaticResource RecentReviewTemplate}"
                    ItemsSource="{x:Bind ViewModel.RecentReviews, Mode=OneWay}"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.HasRecentReviews, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    x:Uid="NoRecentReviewsText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ViewModel.HasNoRecentReviews, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
